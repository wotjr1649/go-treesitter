CREATE EXTERNAL TABLE db1.dbo.ext1 (c1 int NOT NULL, c2 nvarchar(50) COLLATE Latin1_General_CI_AS NULL) WITH (LOCATION = '/data/ext1/', DATA_SOURCE = ds1, FILE_FORMAT = ff1, REJECT_TYPE = percentage, REJECT_VALUE = 10, REJECT_SAMPLE_VALUE = 1000, REJECTED_ROW_LOCATION = '/REJECT_Directory');
CREATE EXTERNAL TABLE dbo.ext2 (c1 int) WITH (LOCATION = '/data/ext2/', DATA_SOURCE = ds1, FILE_FORMAT = ff1, REJECT_TYPE = value, REJECT_VALUE = 5);
CREATE EXTERNAL TABLE ext3 (c1 int) WITH (LOCATION = '/data/ext3/', DATA_SOURCE = ds1);
