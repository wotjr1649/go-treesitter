package gen

type Number interface {
	~int | ~int64 | float64
}
type Ordered interface {
	~int | ~string
	String() string
}
type OnlyInt interface{ int }
type List[T any] struct {
	next *List[T]
	val  T
}
type Pair[K comparable, V any] struct {
	k K
	v V
}
type Tree[T interface{ ~int | ~string }] struct{ left, right *Tree[T] }
type Ptr[P *Q, Q any] struct{}
type Ptr2[P interface{ *Q }, Q any] struct{}
type Ptr3[P *Q,] struct{}
type Wrapper[T any] struct {
	List[T]
	*Pair[string, T]
}
type Set[T comparable] = map[T]struct{}
type IntList = List[int]
func Map[S ~[]E, E, R any](s S, f func(E) R) []R { return nil }
func Sum[T Number](xs ...T) (s T) { return }
func (l *List[T]) Push(v T) {}
func (p Pair[K, V]) Key() K { return p.k }
func (p Pair[_, V]) Val() V { return p.v }
func use() {
	var l List[int]
	_ = Map[[]int, int, string]
	_ = Sum[float64]
	_ = Pair[string, int]{k: "a", v: 1}
	_ = List[int]{}
	_ = (*List[int]).Push
	_ = l
	_ = Map[[]int,]
}
