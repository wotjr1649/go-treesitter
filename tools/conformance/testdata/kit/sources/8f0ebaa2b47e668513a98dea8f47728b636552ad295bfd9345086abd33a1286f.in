SELECT a, SUM(b) OVER w AS s, AVG(b) OVER w2 AS m
FROM dbo.t
WHERE a IS DISTINCT FROM b OR c IS NOT DISTINCT FROM NULL
WINDOW w AS (PARTITION BY a), w2 AS (w ORDER BY b);
SELECT FIRST_VALUE(b) IGNORE NULLS OVER (ORDER BY a) AS f FROM dbo.t;
SELECT JSON_OBJECT('k': 1, 'n': NULL ABSENT ON NULL) AS o, N'x' || N'y' AS c;
