package exprs

import (
	"fmt"
	"math"
)

type Point struct{ x, y int }
type T struct{ a int; b string }
func (T) Mv(int) int { return 0 }
func (*T) Mp(float32) float32 { return 0 }

func f(x, y int, p *T, m map[string]int, s []int, a [4]int, i interface{}, ch chan int, str string) {
	_ = x + y - x*y/2%3<<1>>1&3|4^5&^6
	_ = x == y || x != y && x < y || x <= y || x > y || x >= y
	_, _, _, _, _, _, _ = +x, -x, !true, ^x, *p, &x, <-ch
	_ = math.Pi
	_ = (x)
	_ = fmt.Sprint
	_ = []int{1, 2, 3}
	_ = [...]string{"a", "b"}
	_ = [2][2]int{{1, 2}, {3, 4}}
	_ = map[string]int{"a": 1, "b": 2}
	_ = map[Point]string{{1, 2}: "a", Point{3, 4}: "b"}
	_ = Point{x: 1, y: 2}
	_ = Point{1, 2}
	_ = &Point{}
	_ = [10]string{2: "x", 5: "y"}
	_ = struct{ a int }{a: 1}
	_ = []*Point{{1, 2}, &Point{3, 4}}
	_ = [][]int{{1}, {2, 3},}
	_ = func(a, b int) int { return a + b }
	_ = func() {}
	_ = p.a
	_ = m["a"]
	_ = s[1]
	_ = s[1,]
	_ = s[1:2]
	_ = s[:2]
	_ = s[1:]
	_ = s[:]
	_ = s[1:2:3]
	_ = s[:2:3]
	_ = str[1:]
	_ = a[0]
	_ = i.(int)
	_, _ = i.(fmt.Stringer)
	fmt.Println(x, y)
	fmt.Println(s...)
	_ = make([]int, 10)
	_ = make(map[string]int)
	_ = new(int)
	_ = append(s, 1,)
	_ = math.Atan2(1, 2)
	_ = T.Mv
	_ = (*T).Mp
	_ = (*T).Mv
	_ = p.Mp
	_ = float64(x)
	_ = []byte(str)
	_ = (*int)(nil)
	_ = (func())(nil)
	_ = (<-chan int)(ch)
	_ = string(rune(x),)
	_ = map[string]int(m)
	_ = chan int(nil)
	_ = 1 + 2i
	_ = 'r'
	_ = "str"
	_ = 1.5
	_ = 42
}
