package expr

type pair struct{ a, b int }

func compute(xs []int, m map[string]int, v any) int {
	p := pair{a: 1, b: 2}
	total := -xs[0] + (xs[1] * 2
	sub := xs[1:3]
	_ = []byte("k")
	n, ok := v.(int)
	f := func(x int) int { return x << 1 }
	if !ok {
		n = int(float64(total) / 2)
	}
	return f(n) + p.a + len(sub) + m["k"]
}

func after() []pair {
	return []pair{{1, 2}, {a: 3}}
}
