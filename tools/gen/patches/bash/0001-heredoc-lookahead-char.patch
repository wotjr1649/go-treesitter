+// The delimiter keeps one byte per code point: ASCII is compared exactly and a non-ASCII byte
+// only against the low byte of the lookahead (non-ASCII code points with that byte still alias).
+static inline bool delimiter_byte_matches(char stored, int32_t lookahead) {
+    return (unsigned char)stored < 0x80 ? (int32_t)(unsigned char)stored == lookahead : stored == (char)lookahead;
+}
