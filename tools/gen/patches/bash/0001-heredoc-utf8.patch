+// Keep decode errors distinct from every valid UTF-8 sequence, including U+FFFD.
+static inline uint32_t encode_utf8(int32_t c, uint8_t *out) {
+    if (c < 0) { out[0] = 0xFF; return 1; }
+    if (c < 0x80) { out[0] = (uint8_t)c; return 1; }
+    uint32_t n = c < 0x800 ? 2 : c < 0x10000 ? 3 : 4;
+    out[0] = (uint8_t)((0xF00 >> n) | (c >> (6 * (n - 1))));
+    for (uint32_t i = 1; i < n; i++) out[i] = (uint8_t)(0x80 | ((c >> (6 * (n - 1 - i))) & 0x3F));
+    return n;
+}
