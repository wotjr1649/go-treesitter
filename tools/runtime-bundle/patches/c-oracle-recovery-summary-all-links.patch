+// cRecoverMaxSummaryIterators is C stack.c MAX_ITERATOR_COUNT.
+const cRecoverMaxSummaryIterators = 64
+
+// cRecoverElectionFollowsPackedLinks reports whether cRecoverStrategy1Election
+// can pop a summary entry through a non-zero GSS link.
+func (p *Parser) cRecoverElectionFollowsPackedLinks() bool {
+	return p.language != nil && (p.language.RecoveryStackVersionOrderEnabled || p.closedRecoveryHistoriesCertified())
+}
+
+// cRecordSummaryAllLinks ports ts_stack_record_summary over every link of a
+// multi-link GSS head (stack.c stack__iter with summarize_stack_callback).
+// Each pass visits the live iterators in order. A stopped iterator leaves the
+// set at once, so its slot is free for a later split in the same pass. Links
+// 1..k append new iterators up to MAX_ITERATOR_COUNT, then link 0 advances the
+// current one in place. Each iterator records its node at its own non-extra
+// depth, with C's duplicate check over the trailing same-depth entries. A
+// node-less entry takes the position of the nearest payload below it, as
+// cRecordSummaryWithScratch does.
+//
+// cRecoverElectionDepthIter enumerates every member summary depth-major, the
+// order this engine already uses for C's merged version. Extras can make the
+// record order revisit a smaller depth, so the result is stably sorted by depth.
+func cRecordSummaryAllLinks(head *gssNode) []cStackSummaryEntry {
+	type summaryIterator struct {
+		node  *gssNode
+		depth int
+	}
+	var summary []cStackSummaryEntry
+	record := func(depth int, n *gssNode) {
+		for j := len(summary) - 1; j >= 0; j-- {
+			if int(summary[j].depth) < depth {
+				break
+			}
+			if int(summary[j].depth) == depth && summary[j].state == n.entry.state {
+				return
+			}
+		}
+		var posBytes, posRow uint32
+		for m := n; m != nil; m = m.prev {
+			if stackEntryHasNode(m.entry) {
+				posBytes = stackEntryNodeEndByte(m.entry)
+				posRow = stackEntryNodeEndPoint(m.entry).Row
+				break
+			}
+		}
+		summary = append(summary, cStackSummaryEntry{depth: uint8(depth), state: n.entry.state, posBytes: posBytes, posRow: posRow})
+	}
+	iterators := []summaryIterator{{node: head}}
+	for len(iterators) > 0 {
+		for i, size := 0, len(iterators); i < size; i++ {
+			it := iterators[i]
+			if it.depth <= cRecoverMaxSummaryDepth {
+				record(it.depth, it.node)
+			}
+			if it.depth > cRecoverMaxSummaryDepth || it.node.prev == nil {
+				iterators = append(iterators[:i], iterators[i+1:]...)
+				i--
+				size--
+				continue
+			}
+			links := it.node.linkCount()
+			for j := 1; j <= links; j++ {
+				li := j
+				if j == links {
+					li = 0
+				} else if len(iterators) >= cRecoverMaxSummaryIterators {
+					continue
+				}
+				prev, entry := it.node.link(li)
+				next := summaryIterator{node: prev, depth: it.depth}
+				if cEntryCountsTowardDepth(entry) {
+					next.depth++
+				}
+				if li == 0 {
+					iterators[i] = next
+				} else if prev != nil {
+					iterators = append(iterators, next)
+				}
+			}
+		}
+	}
+	slices.SortStableFunc(summary, func(a, b cStackSummaryEntry) int { return int(a.depth) - int(b.depth) })
+	return summary
+}
