+func (p *Parser) acceptStack(s *glrStack) {
+	if !s.accepted && p != nil {
+		p.cNextAcceptOrder++
+		s.cAcceptOrder = p.cNextAcceptOrder
+	}
+	s.accepted = true
+}
+
