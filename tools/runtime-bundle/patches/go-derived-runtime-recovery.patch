+func normalizeGoAnonymousNULName(lang *gotreesitter.Language) bool {
+	if lang == nil {
+		return false
+	}
+	index := -1
+	for i, name := range lang.SymbolNames {
+		if name != "\x00" {
+			continue
+		}
+		if index >= 0 || i >= len(lang.SymbolMetadata) {
+			return false
+		}
+		index = i
+	}
+	if index < 0 {
+		return false
+	}
+	lang.SymbolNames[index] = ""
+	lang.SymbolMetadata[index].Name = ""
+	return true
+}
